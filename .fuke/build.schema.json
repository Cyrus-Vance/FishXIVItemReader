{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "definitions": {
    "Host": {
      "type": "string",
      "enum": [
        "AppVeyor",
        "AzurePipelines",
        "Bamboo",
        "Bitbucket",
        "Bitrise",
        "GitHubActions",
        "GitLab",
        "Jenkins",
        "Rider",
        "SpaceAutomation",
        "TeamCity",
        "Terminal",
        "TravisCI",
        "VisualStudio",
        "VSCode"
      ]
    },
    "ExecutableTarget": {
      "type": "string",
      "enum": [
        "Compile",
        "Github",
        "Local",
        "Package",
        "Restore"
      ]
    },
    "Verbosity": {
      "type": "string",
      "description": "",
      "enum": [
        "Verbose",
        "Normal",
        "Minimal",
        "Quiet"
      ]
    },
    "FukeBuild": {
      "properties": {
        "Continue": {
          "type": "boolean",
          "description": "Continue the previous failed build."
        },
        "Help": {
          "type": "boolean",
          "description": "Show help for this build assembly."
        },
        "Host": {
          "description": "Execution host. Defaults to 'automatic'.",
          "$ref": "#/definitions/Host"
        },
        "NoLogo": {
          "type": "boolean",
          "description": "Suppress the FUKE header and ASCII logo."
        },
        "Partition": {
          "type": "string",
          "description": "Partition used on CI."
        },
        "Plan": {
          "type": "boolean",
          "description": "Show the execution plan as HTML."
        },
        "Profile": {
          "type": "array",
          "description": "Profiles to load.",
          "items": {
            "type": "string"
          }
        },
        "Root": {
          "type": "string",
          "description": "Root directory used during build execution."
        },
        "Skip": {
          "type": "array",
          "description": "List of targets to skip. An empty list skips all dependencies.",
          "items": {
            "$ref": "#/definitions/ExecutableTarget"
          }
        },
        "Target": {
          "type": "array",
          "description": "List of targets to invoke. Defaults to '{default_target}'.",
          "items": {
            "$ref": "#/definitions/ExecutableTarget"
          }
        },
        "Verbosity": {
          "description": "Logging verbosity during build execution. Defaults to 'Normal'.",
          "$ref": "#/definitions/Verbosity"
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "ActInstallDir": {
          "type": "string",
          "description": "ACT installation directory used only as the compile-time reference source."
        },
        "Configuration": {
          "type": "string",
          "description": "Build configuration used for plugin compilation.",
          "enum": [
            "Debug",
            "Release"
          ]
        },
        "GitHubRepository": {
          "type": "string",
          "description": "GitHub repository in owner/name form. Defaults to the origin remote."
        },
        "LocalPluginDirectory": {
          "type": "string",
          "description": "Local ACT plugin directory updated by the Local target."
        },
        "ReleaseNotes": {
          "type": "string",
          "description": "Release notes used by Github."
        },
        "Version": {
          "type": "string",
          "description": "Release version used by Package/Github. Defaults to Properties/AssemblyVersion.cs."
        },
        "VersionPart": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Version part incremented by Github. 1=0.0.0.x, 2=0.0.x.0, 3=0.x.0.0, 4=x.0.0.0.",
          "format": "int32"
        }
      }
    },
    {
      "$ref": "#/definitions/FukeBuild"
    }
  ]
}
